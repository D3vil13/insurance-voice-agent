# Example API Keys Configuration
# Copy this file to 'apikeys.env' and add your actual keys

# OpenRouter API Key (Required for LLM responses)
# Get your key from: https://openrouter.ai/
OPENROUTER_API_KEY=your_key

# Sarvam AI API Key (Required for voice STT/TTS features)
# Get your key from: https://dashboard.sarvam.ai/
SARVAM_API_KEY=your_key
